# Copy to .env.prod and fill in. Used only by the `:prod` scripts, never by the
# application: Next.js does not load this file, so nothing can pick it up by
# accident.
#
#   cp .env.prod.example .env.prod
#   npm run db:migrate:prod
#   npm run db:check:prod
#
# .env.prod is gitignored. The production database password does not belong in
# the repository, and it does not belong in your shell history either -- which
# is why it lives here rather than on a command line.

DATABASE_URL=
