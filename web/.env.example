# Copy to .env.local and fill in. .env.local is gitignored -- keep the real
# values out of the repository.

# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the connection pooler URI (port 6543) for the app.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase: dashboard -> Storage -> S3 Connection
#   https://supabase.com/dashboard/project/_/storage/s3
# Turn on "Enable connection via S3 protocol" there, then create an access key.
# The endpoint uses the dedicated storage host, which Supabase recommends for
# large uploads: https://<project-ref>.storage.supabase.co/storage/v1/s3
# For Cloudflare R2 the same four values come from the bucket's API tokens.
STORAGE_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=<region>
STORAGE_BUCKET=cad-models
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Auth.js. Generate the secret with: npx auth secret
# GitHub sign-in needs an OAuth App:
#   https://github.com/settings/developers -> New OAuth App
#   Homepage        http://localhost:3000
#   Callback URL    http://localhost:3000/api/auth/callback/github
# Leave the GitHub values empty in development and use the development
# sign-in on /sign-in instead.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared secret for the Inventor translation agent (agent/README.md).
# Leave empty unless an agent is running; empty means the agent endpoints
# refuse every request. Generate one with: openssl rand -base64 32
AGENT_TOKEN=

# Optional, shown with their defaults.
# STORAGE_URL_TTL_SECONDS=900
# MAX_UPLOAD_MB=200

# Email. Unset is a valid configuration: with no key the messages are written to
# the log instead of being sent, which is what makes password reset testable on
# a machine with no mail provider.
#
# MAIL_FROM has to be an address at a domain verified with the provider.
# Without one, a provider will only deliver to your own account's address.
MAIL_API_KEY=
MAIL_FROM="CAD Models <noreply@example.com>"

# Where links in email should point. Vercel supplies its own deployment URL, so
# this is only needed for a custom domain or a non-default local port.
SITE_URL=
