# Production values for the Fly worker. Copy to .env.fly, fill in, then:
#
#   fly secrets import < .env.fly
#
# Piped rather than passed as arguments: `fly secrets set KEY=value` puts the
# value in your shell history, and a storage secret key does not belong there.
#
# .env.fly is gitignored. Delete it once the secrets are set if you would
# rather not keep a copy on disk -- Fly stores them and the worker reads them
# from the environment.

DATABASE_URL=
STORAGE_ENDPOINT=
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=cad-models
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
